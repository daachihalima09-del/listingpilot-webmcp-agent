# Required in production. Generate a random value with at least 32 characters.
CHALLENGE_STATE_SECRET=replace-with-a-random-value-at-least-32-characters

# Required in production for durable challenge state across reloads and serverless instances.
# Use the normal write-enabled REST token, never the read-only REST token.
UPSTASH_REDIS_REST_URL=https://replace-with-your-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
